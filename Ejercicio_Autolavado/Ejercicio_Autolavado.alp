					<TextCode><![CDATA["Porcentaje de perdidos: " +
String.format("%.2f", source.count() == 0 ? 0 :
100.0 * sinkPerdidos.count() / source.count()) + "%"]]></TextCode>
					<Font>
						<Name>Arial</Name>
						<Size>12</Size>
						<Style>0</Style>
					</Font>
					<Alignment>LEFT</Alignment>
				</Text>
				<Text>
					<Id>1795676962281</Id>
					<Name><![CDATA[text7]]></Name>
					<X>120</X><Y>30</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D</DrawMode>
					<EmbeddedIcon>false</EmbeddedIcon>
					<Z>0</Z>
					<Rotation>0.0</Rotation>
					<Color>-16777216</Color>
					<Text><![CDATA[text]]></Text>
					<TextCode><![CDATA["Autos en el sistema: " + nSistema]]></TextCode>
					<Font>
						<Name>Arial</Name>
						<Size>12</Size>
						<Style>1</Style>
					</Font>
					<Alignment>LEFT</Alignment>
				</Text>
				<Text>
					<Id>1795677001443</Id>
					<Name><![CDATA[text8]]></Name>
					<X>120</X><Y>60</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D</DrawMode>
					<EmbeddedIcon>false</EmbeddedIcon>
					<Z>0</Z>
					<Rotation>0.0</Rotation>
					<Color>-16777216</Color>
					<Text><![CDATA[text]]></Text>
					<TextCode><![CDATA["Autos en espera: " + nCola]]></TextCode>
					<Font>
						<Name>Arial</Name>
						<Size>12</Size>
						<Style>1</Style>
					</Font>
					<Alignment>LEFT</Alignment>
				</Text>
				<Text>
					<Id>1795706435321</Id>
					<Name><![CDATA[Resultados]]></Name>
					<X>610</X><Y>380</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D</DrawMode>
					<EmbeddedIcon>false</EmbeddedIcon>
					<Z>0</Z>
					<Rotation>0.0</Rotation>
					<Color>-16777216</Color>
					<Text><![CDATA[Resultados]]></Text>
					<TextCode><![CDATA["RESULTADOS DE LA SIMULACIÓN\n\n" +

"Ws = " + String.format("%.2f",
(source.count() - sinkPerdidos.count() == 0 ? 0 :
(queue.statsSize.mean() + delay.statsUtilization.mean())
* time() * 60 / (source.count() - sinkPerdidos.count())))
+ " minutos\nTiempo promedio en el sistema.\n\n" +

"Wq = " + String.format("%.2f",
(source.count() - sinkPerdidos.count() == 0 ? 0 :
queue.statsSize.mean() * time() * 60 /
(source.count() - sinkPerdidos.count())))
+ " minutos\nTiempo promedio de espera en la cola.\n\n" +

"Ls = " + String.format("%.4f",
queue.statsSize.mean() + delay.statsUtilization.mean())
+ " autos\nNúmero promedio de autos en el sistema.\n\n" +

"Lq = " + String.format("%.4f",
queue.statsSize.mean())
+ " autos\nNúmero promedio de autos en la cola."]]></TextCode>
