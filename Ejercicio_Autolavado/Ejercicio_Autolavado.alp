	<Experiments>
		<!--   =========   Simulation Experiment   ========  -->
		<SimulationExperiment ActiveObjectClassId="1795654360561">
			<Id>1795654360568</Id>
			<Name><![CDATA[Simulation]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<MaximumMemory>512</MaximumMemory>
			<RandomNumberGenerationType>fixedSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<AfterSimulationRunCode><![CDATA[root.registrar();

double T = root.time();
double perdidos = root.sinkPerdidos.count();
double llegadas = root.source.count();
double aceptados = llegadas - perdidos;

double Lq = root.queue.statsSize.mean();
double Ls = Lq + root.delay.statsUtilization.mean();

double lambdaE = T == 0 ? 0 : aceptados / T;

double Ws = lambdaE == 0 ? 0 : Ls / lambdaE;
double Wq = lambdaE == 0 ? 0 : Lq / lambdaE;

traceln("RESULTADOS DE LA SIMULACION");

traceln("Ls = " + Ls + " autos");
traceln("Lq = " + Lq + " autos");

traceln("Ws = " + Ws + " horas");
traceln("Wq = " + Wq + " horas");

traceln("Ws = " + Ws * 60 + " minutos");
traceln("Wq = " + Wq * 60 + " minutos");

traceln("Clientes perdidos = " + perdidos);

traceln("Prob. de perder un auto = " +
    (llegadas == 0 ? 0 : perdidos / llegadas));

traceln("Lambda efectiva = " + lambdaE);

for (int n = 0; n <= 5; n++) {
    traceln("p" + n + " = " +
        (T == 0 ? 0 : root.tiempoEn[n] / T));
}]]></AfterSimulationRunCode>
			<SeedValue>1</SeedValue>
